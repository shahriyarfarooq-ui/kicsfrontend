<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /web/

  # Serve existing files/directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send everything else to the SPA entry point
  RewriteRule . /web/index.html [L]
</IfModule>
